# Optional overrides only — primary provisioning is BLE WIFI_CONFIG → mqtt.json.
# Copy to /etc/systemd/system/rover-daemon.service.d/mqtt.conf
# then: sudo systemctl daemon-reload && sudo systemctl restart rover-daemon
#
# Auth: TLS + username/password (no client certs).
[Service]
Environment=ROVER_MQTT_HOST=YOUR_BROKER_HOST
Environment=ROVER_MQTT_USER=YOUR_USER
Environment=ROVER_MQTT_PASS=YOUR_PASS
# Optional:
# Environment=ROVER_MQTT_PORT=8883
# Environment=ROVER_MQTT_URL=mqtts://YOUR_BROKER_HOST:8883
# Environment=ROVER_MQTT_TOPIC_PREFIX=tenants/YOUR_USER
# Environment=ROVER_MQTT_TOPIC_CMD=tenants/YOUR_USER/cmd
# Environment=ROVER_MQTT_TOPIC_STATUS=tenants/YOUR_USER/status
# Environment=ROVER_MQTT_WAKE_SECRET=YOUR_WAKE_SECRET
# Environment=ROVER_MQTT_RAIL_OFF=OFF GPIO16 DELAY 15
