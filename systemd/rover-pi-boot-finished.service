[Unit]
Description=Rover Pi MQTT boot finished
# Fire as soon as the camera stack is up. Do not wait for network-online or
# rover-daemon (those added ~10s after cam was already ready). MQTT publish
# retries if the link is still coming up.
After=rover-mediamtx.service rover-control.service rover-watch.service rover-pi-status.service
Wants=rover-pi-status.service rover-mediamtx.service rover-control.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/rover-firmware/pi
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/rover-firmware/pi
ExecStart=/opt/rover-firmware/venv/bin/python -m rover_daemon.pi_status boot_finished
TimeoutStartSec=120
User=root

[Install]
WantedBy=multi-user.target
