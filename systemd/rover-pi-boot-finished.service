[Unit]
Description=Rover Pi MQTT cam_ready + boot finished
# Start as soon as mediamtx forks so we can publish PI cam_ready the moment
# the H264 path is live — do not wait for control/gimbal. wait_for_stack()
# inside still requires control+watch for PI boot_finished.
# Do not wait on NetworkManager / network-online (those lagged cam by ~10–20s).
After=rover-mediamtx.service
Wants=rover-mediamtx.service rover-control.service rover-watch.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/rover-firmware/pi
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/rover-firmware/pi
ExecStart=/opt/rover-firmware/venv/bin/python -m rover_daemon.pi_status boot_finished
TimeoutStartSec=120
User=root

[Install]
WantedBy=multi-user.target
