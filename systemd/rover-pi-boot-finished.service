[Unit]
Description=Rover Pi MQTT boot finished
# Fire when the camera/control stack is up. Do not wait on NetworkManager,
# rover-pi-status, or network-online — those added ~10–20s after cam was ready.
# MQTT publish retries inside pi_status if the link is still coming up.
After=rover-mediamtx.service rover-control.service rover-watch.service
Wants=rover-mediamtx.service rover-control.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/rover-firmware/pi
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/rover-firmware/pi
ExecStart=/opt/rover-firmware/venv/bin/python -m rover_daemon.pi_status boot_finished
TimeoutStartSec=120
User=root

[Install]
WantedBy=multi-user.target
