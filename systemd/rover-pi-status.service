[Unit]
Description=Rover Pi MQTT status (boot start and heartbeat)
# Start at local-fs so MQTT status can come up in parallel with NM/Wi-Fi.
# Do NOT Before=mediamtx/control or gate boot_finished — those forced ~10–20s waits.
DefaultDependencies=no
After=local-fs.target
Wants=NetworkManager.service
Before=rover-daemon.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
WorkingDirectory=/opt/rover-firmware/pi
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/rover-firmware/pi
ExecStart=/opt/rover-firmware/venv/bin/python -m rover_daemon.pi_status run
Restart=always
RestartSec=2
TimeoutStopSec=20
User=root

[Install]
WantedBy=multi-user.target
