[Unit]
Description=Rover Pi MQTT status (boot start and heartbeat)
# Start with NetworkManager so PI boot_start can leave once Wi-Fi has a route.
# Do NOT Before=mediamtx/control — that forced the camera to wait ~10s on NM.
DefaultDependencies=no
After=local-fs.target NetworkManager.service
Wants=NetworkManager.service
Before=network-online.target rover-daemon.service rover-pi-boot-finished.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
WorkingDirectory=/opt/rover-firmware/pi
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/rover-firmware/pi
ExecStart=/opt/rover-firmware/venv/bin/python -m rover_daemon.pi_status run
Restart=always
RestartSec=2
TimeoutStopSec=20
User=root

[Install]
WantedBy=multi-user.target
